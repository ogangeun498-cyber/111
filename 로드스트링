local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

----------------------------------------------------
-- GUI
----------------------------------------------------
local gui = Instance.new("ScreenGui")
gui.Name = "MobileControls"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

----------------------------------------------------
-- 방향 UI
----------------------------------------------------
local holder = Instance.new("Frame")
holder.Size = UDim2.new(0, 220, 0, 70)
holder.Position = UDim2.new(0.5, -110, 1, -100)
holder.BackgroundTransparency = 1
holder.Parent = gui

local function createButton(text, x)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0, 60, 0, 60)
	b.Position = UDim2.new(0, x, 0, 5)
	b.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	b.BackgroundTransparency = 0.2
	b.TextColor3 = Color3.new(1,1,1)
	b.TextScaled = true
	b.Text = text
	b.Parent = holder
	return b
end

local left = createButton("◀", 0)
local dragBtn = createButton("≡", 80)
local right = createButton("▶", 160)

----------------------------------------------------
-- 카메라 회전
----------------------------------------------------
local cooldown = false

local function rotateCamera(deg)
	if cooldown then return end
	cooldown = true

	camera.CFrame = camera.CFrame * CFrame.Angles(0, math.rad(deg), 0)

	task.delay(0.2, function()
		cooldown = false
	end)
end

left.MouseButton1Click:Connect(function()
	rotateCamera(-45)
end)

right.MouseButton1Click:Connect(function()
	rotateCamera(45)
end)

----------------------------------------------------
-- UI 드래그
----------------------------------------------------
local draggingUI = false
local holdStart = 0

dragBtn.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseButton1 then

		holdStart = tick()

		task.spawn(function()
			while tick() - holdStart < 5 do
				if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
				and #UIS:GetTouches() == 0 then
					return
				end
				task.wait()
			end

			draggingUI = true
			dragBtn.Text = "✥"
		end)
	end
end)

dragBtn.InputEnded:Connect(function()
	draggingUI = false
	dragBtn.Text = "≡"
end)

UIS.InputChanged:Connect(function(input)
	if not draggingUI then return end
	if input.UserInputType ~= Enum.UserInputType.MouseMovement
	and input.UserInputType ~= Enum.UserInputType.Touch then return end

	local pos = input.Position
	holder.Position = UDim2.new(
		0, pos.X - holder.AbsoluteSize.X/2,
		0, pos.Y - holder.AbsoluteSize.Y/2
	)
end)

----------------------------------------------------
-- 캐릭터
----------------------------------------------------
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

player.CharacterAdded:Connect(function(char)
	character = char
	humanoid = char:WaitForChild("Humanoid")
end)

----------------------------------------------------
-- 앞으로 이동 버튼
----------------------------------------------------
local forward = Instance.new("TextButton")
forward.Size = UDim2.new(0, 60, 0, 60)
forward.Position = UDim2.new(1, -80, 1, -180)
forward.BackgroundColor3 = Color3.fromRGB(50,50,50)
forward.BackgroundTransparency = 0.2
forward.Text = "↑"
forward.TextScaled = true
forward.TextColor3 = Color3.new(1,1,1)
forward.Parent = gui

local moving = false

forward.MouseButton1Down:Connect(function()
	moving = true
end)

forward.MouseButton1Up:Connect(function()
	moving = false
end)

forward.TouchEnded:Connect(function()
	moving = false
end)

----------------------------------------------------
-- 🔥 안정 핵심: 카메라 기준 이동 (버그 제거 버전)
----------------------------------------------------
RunService.RenderStepped:Connect(function()
	if not moving or not humanoid then return end
	if not camera then return end

	local look = camera.CFrame.LookVector

	local dir = Vector3.new(look.X, 0, look.Z)

	local mag = dir.Magnitude
	if mag > 0.001 then
		dir = dir / mag
		humanoid:Move(dir, false)
	end
end)
