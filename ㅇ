local forwardButton = Instance.new("TextButton")
forwardButton.Size = UDim2.new(0, 60, 0, 60)
forwardButton.Position = UDim2.new(1, -80, 1, -180)
forwardButton.AnchorPoint = Vector2.new(0, 0)
forwardButton.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
forwardButton.BackgroundTransparency = 0.2
forwardButton.Text = "↑"
forwardButton.TextScaled = true
forwardButton.TextColor3 = Color3.new(1, 1, 1)
forwardButton.Parent = gui

local moving = false

forwardButton.MouseButton1Down:Connect(function()
	moving = true
end)

forwardButton.MouseButton1Up:Connect(function()
	moving = false
end)

forwardButton.TouchLongPress:Connect(function(_, state)
	if state == Enum.UserInputState.Begin then
		moving = true
	elseif state == Enum.UserInputState.End then
		moving = false
	end
end)

RunService.RenderStepped:Connect(function()
	if moving and humanoid then
		humanoid:Move(Vector3.new(0, 0, -1), false)
	end
end)local UIS = game:GetService("UserInputService")

