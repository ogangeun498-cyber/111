local Players = game:GetService("Players")

local player = Players.LocalPlayer
local gui = Instance.new("ScreenGui")
gui.Name = "MobileControls"
gui.ResetOnSpawn = false
gui.Parent = player:WaitForChild("PlayerGui")

local holder = Instance.new("Frame")
holder.Size = UDim2.new(0, 220, 0, 70)
holder.Position = UDim2.new(0.5, -110, 1, -100)
holder.BackgroundTransparency = 1
holder.Parent = gui

local function createButton(text, x)
	local button = Instance.new("TextButton")
	button.Size = UDim2.new(0, 60, 0, 60)
	button.Position = UDim2.new(0, x, 0, 5)
	button.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
	button.BackgroundTransparency = 0.2
	button.TextColor3 = Color3.new(1, 1, 1)
	button.TextScaled = true
	button.Text = text
	button.Parent = holder
	return button
end

local leftButton = createButton("◀", 0)
local moveButton = createButton("≡", 80)
local rightButton = createButton("▶", 160)local camera = workspace.CurrentCamera
local cooldown = false

local function rotateCamera(degrees)
	if cooldown then
		return
	end

	cooldown = true

	local cf = camera.CFrame
	local pos = cf.Position

	camera.CFrame = cf * CFrame.Angles(0, math.rad(degrees), 0)

	task.delay(0.25, function()
		cooldown = false
	end)
end

leftButton.MouseButton1Click:Connect(function()
	rotateCamera(-45)
end)

rightButton.MouseButton1Click:Connect(function()
	rotateCamera(45)
end)local UIS = game:GetService("UserInputService")

local dragging = false
local dragEnabled = false
local holdStart = 0

moveButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseButton1 then

		holdStart = tick()
		dragEnabled = false

		task.spawn(function()
			while tick() - holdStart < 5 do
				if not UIS:IsMouseButtonPressed(Enum.UserInputType.MouseButton1)
				and #UIS:GetTouches() == 0 then
					return
				end
				task.wait()
			end

			dragEnabled = true
			dragging = true
			moveButton.Text = "✥"
		end)
	end
end)

moveButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseButton1 then

		dragging = false
		dragEnabled = false
		moveButton.Text = "≡"
	end
end)

UIS.InputChanged:Connect(function(input)
	if not dragging then
		return
	end

	if input.UserInputType == Enum.UserInputType.Touch
	or input.UserInputType == Enum.UserInputType.MouseMovement then

		local pos = input.Position

		holder.Position = UDim2.new(
			0,
			pos.X - holder.AbsoluteSize.X / 2,
			0,
			pos.Y - holder.AbsoluteSize.Y / 2
		)
	end
end)local Players = game:GetService("Players")
